{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hermetic.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://hermetic.onrender.com/ws/:path*"
    }
  ]
}
